{% extends 'base.html.twig' %}

{% block title %}Shopping Cart - Our Store{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="mb-4">🛒 Shopping Cart</h1>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success">{{ message }}</div>
    {% endfor %}

    {% if items is empty %}
        <div class="alert alert-info">
            Votre panier est vide.
            <a href="{{ path('app_home') }}" class="alert-link">Continuer les achats</a>
        </div>
    {% else %}
        <div class="row">
            <div class="col-lg-8">
                <div class="card mb-3">
                    <div class="card-body">
                        <table class="table align-middle">
                            <thead>
                                <tr>
                                    <th>Produit</th>
                                    <th>Prix</th>
                                    <th>Quantité</th>
                                    <th>Total</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in items %}
                                <tr>
                                    <td>
                                        <h6 class="mb-0">{{ item.product.name }}</h6>
                                        <small class="text-muted">
                                            {{ item.product.category ? item.product.category.name : '' }}
                                        </small>
                                    </td>
                                    <td>${{ item.product.price }}</td>
                                    <td>{{ item.quantity }}</td>
                                    <td class="fw-bold">${{ item.total }}</td>
                                    <td>
                                        <a href="{{ path('app_cart_remove', {id: item.product.id}) }}" 
                                           class="btn btn-sm btn-outline-danger">
                                            🗑️ Supprimer
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_home') }}" class="btn btn-outline-primary">
                        ← Continuer les achats
                    </a>
                    <a href="{{ path('app_cart_clear') }}" class="btn btn-outline-danger">
                        🗑️ Vider le panier
                    </a>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Résumé de la commande</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Sous-total :</span>
                            <span>${{ total }}</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Livraison :</span>
                            <span class="text-success">Gratuite</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Total :</span>
                            <span class="text-success">${{ total }}</span>
                        </div>
                        <div class="d-grid mt-3">
                            <button class="btn btn-success btn-lg">
                                ✅ Passer la commande
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}