{% extends 'base.html.twig' %}

{% block title %}My Profile - Our Store{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row">

        <div class="col-md-3">
            <div class="card">
                <div class="card-body text-center">
                    <div class="display-1 mb-3">👤</div>
                    <h5 class="card-title">{{ user.fullName }}</h5>
                    <p class="text-muted">{{ user.email }}</p>
                    <hr>
                    <ul class="list-unstyled">
                        <li class="mb-2"><a href="#profile" class="text-decoration-none">Profile Information</a></li>
                        <li class="mb-2"><a href="#orders" class="text-decoration-none">My Orders</a></li>
                        <li class="mb-2">
                            <a href="{{ path('app_logout') }}" class="text-decoration-none text-danger">Logout</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="col-md-9">
            <div class="card mb-4" id="profile">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Profile Information</h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="fw-bold">Full Name:</label>
                            <p>{{ user.fullName }}</p>
                        </div>
                        <div class="col-md-6">
                            <label class="fw-bold">Email:</label>
                            <p>{{ user.email }}</p>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="fw-bold">Roles:</label>
                            <p>{{ user.roles|join(', ') }}</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card" id="orders">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Order History</h5>
                </div>
                <div class="card-body">
                    <p class="text-muted">No orders yet. <a href="{{ path('app_home') }}">Start shopping!</a></p>
                </div>
            </div>
        </div>

    </div>
</div>
{% endblock %}